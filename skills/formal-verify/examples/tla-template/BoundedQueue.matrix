# Matrix file for tlc-matrix.sh. Copy it beside your spec as <Name>.matrix and
# edit. Paths are relative to this file. A `spec` line resets the `check`
# lines; each `run` is one TLC run with the CONSTANTS after the bar. Each spec
# must name its top-level formula Spec. mutate.py reads the checks and runs of
# <Name>.matrix for the mutations in <Name>.mutations. A set-valued constant
# has no spaces; model values are bare names.

spec BoundedQueue.tla
check INVARIANTS TypeOK InWindow Owned InOrder ErrorInOrder NoDeliveryAfterError NoLeak
check PROPERTIES NextReturns CloseReturns AllConsumed
# Each reach check names a state the properties depend on and the first run whose label holds the text after the bar.
reach WindowFull | window=1
reach WorkerParked | window=1
reach ConsumerParked | window=1
reach Failed | fail=
# Windows of 1, 2 and the shipped 4; 0, 1, 3 and 5 items; one, two and three workers; and an
# injected failure at the only item and at an item behind one still being built.
run window=1 items=3 workers=1 | Window=1 Items=3 Workers={w1} FailAt={}
run window=2 items=5 workers=2 | Window=2 Items=5 Workers={w1,w2} FailAt={}
run window=4 items=5 workers=3 | Window=4 Items=5 Workers={w1,w2,w3} FailAt={}
run window=4 items=0 workers=2 | Window=4 Items=0 Workers={w1,w2} FailAt={}
run window=2 items=1 workers=3 fail=0 | Window=2 Items=1 Workers={w1,w2,w3} FailAt={0}
run window=2 items=3 workers=2 fail=1 | Window=2 Items=3 Workers={w1,w2} FailAt={1}
